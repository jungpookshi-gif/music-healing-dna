# Configure environment on the backend host. This file is NOT read automatically.
# Demo only: the backend's default password is 1234. No real participant data.
DEMO_MODE=true
ADMIN_PASSWORD=1234
HOST=127.0.0.1
PORT=8787
# Exact frontend origin; no path or trailing slash. Empty means same origin.
ALLOWED_ORIGIN=
# DATA_FILE=/private/path/responses.json
# Optional LOCAL preview only: serve allowlisted frontend files alongside API.
# SERVE_STATIC=1
# STATIC_PREFIX=/music-healing-dna
