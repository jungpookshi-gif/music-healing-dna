// Shared validation snapshot from assets/core.js. No build step needed.
var MHD_CORE = (function(){
'use strict';
const A_COLS=['pid','age','gender','culture','status','listen_min','stress_genre','purpose','genre_like','stress_week','is_simulated'];
const B_COLS=['pid','condition','date','genre','before','after','delta','bpm','like','setting','track','track_url','note','duration_sec','session_order','is_simulated'];
const values={gender:['female','male','nonbinary','other','na'],culture:['vn','kr','other','na'],status:['student','work','both','other'],genre:['pop','ballad','classical_piano','lofi_ambient','rock_metal','hiphop_rnb','traditional','other'],purpose:['destress','study_work','sleep','commute','entertain','other'],condition:['self','relax','energy','silence'],setting:['quiet_room','home','lab','other']};
function number(v){return v===''||v==null?'':Number(v)}
function integer(v,min,max=Number.MAX_SAFE_INTEGER){let n=number(v);return n!==''&&Number.isSafeInteger(n)&&n>=min&&n<=max}
function validateA(v){const e=[];let pid=String(v.pid||'').trim().toUpperCase();if(!/^M\d{4}$/.test(pid))e.push('A01');if(!integer(v.age,18))e.push('A02');for(const [key,id] of [['gender','A03'],['culture','A04']])if(!values[key].includes(v[key]))e.push(id);if(v.status&&!values.status.includes(v.status))e.push('A05');if(v.listen_min!==''&&!integer(v.listen_min,0,1440))e.push('A06');if(!values.genre.includes(v.stress_genre))e.push('A07');if(v.purpose&&!values.purpose.includes(v.purpose))e.push('A08');if(!integer(v.genre_like,0,10))e.push('A09');if(!integer(v.stress_week,0,10))e.push('A10');if(!v.consent)e.push('consent');const row={};for(const k of A_COLS)row[k]=v[k]??'';row.pid=pid;for(const k of ['age','listen_min','genre_like','stress_week'])row[k]=number(v[k]);row.is_simulated=v.is_simulated?1:0;return {errors:e,row};}
// Apps Script V8 has no URL/URLSearchParams. Conservative absolute HTTP(S) validation.
function cleanURL(v){v=String(v||'').trim();if(!v)return '';if(v.length>300||/[\\\s\u0000-\u001f]/.test(v)||!/^https?:\/\/[a-z0-9.-]+(?::[0-9]{1,5})?(?:[/?#][^\s\\]*)?$/i.test(v))throw Error('track_url');
var hashIndex=v.indexOf('#'),fragment=hashIndex<0?'':v.slice(hashIndex),base=hashIndex<0?v:v.slice(0,hashIndex),q=base.indexOf('?');if(q<0)return v;var kept=base.slice(q+1).split('&').filter(function(part){var key;try{key=decodeURIComponent(part.split('=')[0].replace(/\+/g,' ')).toLowerCase();}catch(e){throw Error('track_url');}return !/^utm_/.test(key)&&!['si','feature','fbclid','igshid','gclid','mc_cid','mc_eid'].includes(key);});return base.slice(0,q)+(kept.length?'?'+kept.join('&'):'')+fragment;}
function buildB(s){const music=s.condition!=='silence';return {pid:s.pid,condition:s.condition,date:s.date,genre:music?s.genre||'':'',before:Number(s.before),after:Number(s.after),delta:Number(s.before)-Number(s.after),bpm:music?s.bpm??'':'',like:music?Number(s.like):'',setting:s.setting,track:music?s.track||'':'',track_url:music?s.track_url||'':'',note:s.note||'',duration_sec:Math.max(0,Math.round(s.duration_sec)),session_order:'',is_simulated:s.is_simulated?1:0};}
function validateB(s){const e=[];if(!/^M\d{4}$/.test(s.pid))e.push('pid');if(!values.condition.includes(s.condition))e.push('condition');for(const k of ['before','after'])if(!integer(s[k],0,10))e.push(k);if(s.condition!=='silence'&&!integer(s.like,0,10))e.push('like');if(!values.setting.includes(s.setting))e.push('setting');if((s.track||'').length>120)e.push('track');if(s.genre&&!values.genre.includes(s.genre))e.push('genre');if(s.bpm!==''&&s.bpm!=null&&(!Number.isFinite(Number(s.bpm))||Number(s.bpm)<20||Number(s.bpm)>300))e.push('bpm');if(!Number.isFinite(s.duration_sec)||s.duration_sec<0)e.push('duration_sec');return e;}
return {A_COLS,B_COLS,values,integer,validateA,cleanURL,buildB,validateB};
})();
